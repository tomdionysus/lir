#
# lir postrm: remove keeps the configuration; purge deletes it, as Debian
# expects of a purge. The node's identity in /var/lib/lir is kept even by a
# purge: a node purged by mistake comes back as itself.

set -e

case "$1" in
    purge)
        rm -rf /etc/lir
        ;;
esac

#DEBHELPER#

exit 0
